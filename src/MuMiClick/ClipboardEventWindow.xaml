<Window x:Class="MuMiClick.ClipboardEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ClipboardEventTitle}" Icon="Assets/MuMiClick.ico"
        Width="560" Height="390" MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#687386"/><SolidColorBrush x:Key="LineBrush" Color="#E3E8F0"/>
    <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="26,7,0,14"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="{DynamicResource ClipboardEventTitle}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{DynamicResource ClipboardEventHelp}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
      <RadioButton x:Name="FixedRadio" Content="{DynamicResource FixedVariableMode}" IsChecked="True" Checked="Mode_Checked" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
      <ComboBox x:Name="VariableCombo"/>
      <RadioButton x:Name="RandomGroupRadio" Content="{DynamicResource RandomVariableGroupMode}" Checked="Mode_Checked" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
      <ComboBox x:Name="GroupCombo"/>
      <TextBlock Text="{DynamicResource RandomVariableGroupHelp}" Margin="26,0,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
      <Button Content="{DynamicResource Insert}" Click="Insert_Click" IsDefault="True" Background="#2563EB" Foreground="White" BorderThickness="0"/>
    </StackPanel>
  </Grid>
</Window>
