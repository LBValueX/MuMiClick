<Window x:Class="MuMiClick.VariablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource VariablesTitle}" Icon="Assets/MuMiClick.ico"
        Width="760" Height="500" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#687386"/><SolidColorBrush x:Key="LineBrush" Color="#E3E8F0"/>
    <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="{DynamicResource VariablesTitle}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource VariablesHelp}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <DataGrid x:Name="VariablesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource FieldBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource VariableName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
        <DataGridTextColumn Header="{DynamicResource VariableGroup}" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
        <DataGridTextColumn Header="{DynamicResource VariableValue}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource AddVariable}" Click="Add_Click" Margin="0"/><Button Content="{DynamicResource DeleteVariable}" Click="Delete_Click"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Cancel}" IsCancel="True"/><Button Content="{DynamicResource Apply}" Click="Apply_Click" IsDefault="True" Background="#2563EB" Foreground="White" BorderThickness="0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
