<Window x:Class="MuMiClick.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ActionEditorTitle}" Icon="Assets/MuMiClick.ico"
        Width="620" Height="570" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#687386"/><SolidColorBrush x:Key="LineBrush" Color="#E3E8F0"/>
    <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="9,6"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="{DynamicResource ActionEditorTitle}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{DynamicResource ActionEditorHelp}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="{DynamicResource ActionType}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="ActionTypeCombo" DisplayMemberPath="Display" SelectionChanged="ActionType_SelectionChanged"/>

        <StackPanel x:Name="PositionPanel" Margin="0,16,0,0">
          <TextBlock Text="{DynamicResource MousePosition}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="X" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="XBox"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Y" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="YBox"/></StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="MouseButtonPanel" Margin="0,16,0,0">
          <TextBlock Text="{DynamicResource MouseButton}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="MouseButtonCombo" DisplayMemberPath="Display"/>
        </StackPanel>

        <StackPanel x:Name="WheelPanel" Margin="0,16,0,0">
          <TextBlock Text="{DynamicResource WheelDelta}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox x:Name="WheelDeltaBox"/>
        </StackPanel>

        <StackPanel x:Name="KeyPanel" Margin="0,16,0,0">
          <TextBlock Text="{DynamicResource KeyboardKey}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="KeyCombo" DisplayMemberPath="Display" IsTextSearchEnabled="True" SelectionChanged="Key_SelectionChanged"/>
          <TextBlock x:Name="KeyDetailsText" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
          <TextBlock Text="{DynamicResource KeyCaptureHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="DurationPanel" Margin="0,16,0,0">
          <TextBlock Text="{DynamicResource InputDuration}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox x:Name="DurationBox"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
      <Button Content="{DynamicResource Apply}" Click="Apply_Click" IsDefault="True" Background="#2563EB" Foreground="White" BorderThickness="0"/>
    </StackPanel>
  </Grid>
</Window>
