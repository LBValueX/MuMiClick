<Window x:Class="MuMiClick.TextTriggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TextTriggerTitle}" Icon="Assets/MuMiClick.ico"
        Width="680" Height="480" MinWidth="580" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#687386"/><SolidColorBrush x:Key="LineBrush" Color="#E3E8F0"/>
    <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="9,6"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="{DynamicResource TextTriggerTitle}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Text="{DynamicResource TextTriggerHelp}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource TextTriggerWindow}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="WindowCombo" DisplayMemberPath="Display"/>
        <Button Grid.Column="1" Content="{DynamicResource Refresh}" Click="Refresh_Click"/>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,16,0,0">
        <TextBlock Text="{DynamicResource TextTriggerText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="ExpectedTextBox"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <RadioButton x:Name="ContainsRadio" Content="{DynamicResource ContainsMatch}" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,0,18,0"/>
          <RadioButton x:Name="ExactRadio" Content="{DynamicResource ExactMatch}" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,16,0,0">
        <TextBlock Text="{DynamicResource TextTriggerTimeout}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="TimeoutBox" Text="60" Width="100" HorizontalAlignment="Left"/>
      </StackPanel>
      <TextBlock Grid.Row="4" Text="{DynamicResource TextTriggerAccessibilityNote}" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
      <Button Content="{DynamicResource Insert}" Click="Insert_Click" IsDefault="True" Background="#2563EB" Foreground="White" BorderThickness="0"/>
    </StackPanel>
  </Grid>
</Window>
