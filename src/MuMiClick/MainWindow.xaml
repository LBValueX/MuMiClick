<Window x:Class="MuMiClick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}"
        Icon="Assets/MuMiClick.ico"
        Width="1120" Height="760" MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ListBrush" Color="#FBFCFE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#687386"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E3E8F0"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#172033"/>
    <SolidColorBrush x:Key="StatusPanelBrush" Color="#263248"/>
    <SolidColorBrush x:Key="StatusDetailBrush" Color="#B8C2D5"/>
    <SolidColorBrush x:Key="StatusCountBrush" Color="#D9E1EF"/>
    <SolidColorBrush x:Key="ModeBackgroundBrush" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="ModeBorderBrush" Color="#D8E1EF"/>
    <SolidColorBrush x:Key="ModeTextBrush" Color="#4E5B70"/>
    <SolidColorBrush x:Key="ModeDotBrush" Color="#8793A5"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFF8F8"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F1C9CB"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C8323A"/>
    <SolidColorBrush x:Key="ActiveEventBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="ActiveEventTextBrush" Color="#123B7A"/>
    <SolidColorBrush x:Key="ActiveEventBorderBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusRecordingBrush" Color="#FF8A93"/>
    <SolidColorBrush x:Key="StatusPlayingBrush" Color="#6EE7B7"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.09" Color="#1F2937"/>

    <Style x:Key="ModernButton" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="86"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="RecordActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="StopActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/><Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="70"/><Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="ModernTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="6,0,12,0"/>
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="6,0,12,0"/>
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0,12,0"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="ModeToggleStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ModeBorder" CornerRadius="16" Padding="13,7" Background="{DynamicResource ModeBackgroundBrush}" BorderBrush="{DynamicResource ModeBorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ModeDot" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource ModeDotBrush}"/>
                <TextBlock Text="{DynamicResource EasyMode}" Foreground="{DynamicResource ModeTextBrush}" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ModeBorder" Property="Background" Value="#E8F0FF"/><Setter TargetName="ModeBorder" Property="BorderBrush" Value="#B9CEFF"/><Setter TargetName="ModeDot" Property="Fill" Value="#2563EB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="MainGrid" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="AdvancedRow" Height="*"/>
      <RowDefinition x:Name="FooterRow" Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="2,0,2,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="58" Height="58" CornerRadius="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
          <Image Source="Assets/MuMiClick-logo.png" Width="50" Height="50" Stretch="Uniform"/>
        </Border>
        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="MuMiClick" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="{DynamicResource AppSubtitle}" Margin="1,3,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{DynamicResource SettingsButton}" Click="Settings_Click" Style="{StaticResource CompactButton}" Margin="0,0,10,0"/>
        <CheckBox x:Name="EasyModeBox" Style="{StaticResource ModeToggleStyle}" Click="EasyMode_Click" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="18" Effect="{StaticResource CardShadow}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <WrapPanel VerticalAlignment="Center">
            <Button x:Name="RecordButton" Click="Record_Click" Style="{StaticResource RecordActionButton}" Content="{DynamicResource Record}"/>
            <Button x:Name="StopButton" Click="Stop_Click" Style="{StaticResource StopActionButton}" Content="{DynamicResource Stop}"/>
            <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Play}"/>
          </WrapPanel>
          <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
            <WrapPanel x:Name="BasicSettingsPanel" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Repeat}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              <TextBox x:Name="RepeatBox" Width="58" Text="1" Style="{StaticResource ModernTextBox}" Margin="8,0,8,0" TextAlignment="Center"/>
              <TextBlock Text="{DynamicResource Times}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <CheckBox x:Name="InfiniteBox" Content="{DynamicResource InfiniteRepeat}" Margin="14,0,0,0"/>
            </WrapPanel>
          </Border>
        </Grid>

        <WrapPanel x:Name="AdvancedActionsPanel" Margin="0,14,0,0">
          <Button x:Name="PauseButton" Click="Pause_Click" Style="{StaticResource ModernButton}" Content="{DynamicResource PauseResume}"/>
          <Button Click="Save_Click" Style="{StaticResource ModernButton}" Content="{DynamicResource Save}"/>
          <Button Click="Load_Click" Style="{StaticResource ModernButton}" Content="{DynamicResource Load}"/>
          <Button Click="SelectTarget_Click" Style="{StaticResource ModernButton}" Content="{DynamicResource SelectTarget}"/>
          <Button Click="Elevate_Click" Style="{StaticResource ModernButton}" Content="{DynamicResource RunAsAdmin}"/>
        </WrapPanel>

        <Border x:Name="AdvancedDivider" Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,14"/>

        <StackPanel x:Name="AdvancedSettingsPanel">
          <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Speed}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="SpeedBox" Width="86" SelectedIndex="1"><ComboBoxItem Content="0.5x"/><ComboBoxItem Content="1.0x"/><ComboBoxItem Content="1.5x"/><ComboBoxItem Content="2.0x"/><ComboBoxItem Content="3.0x"/><ComboBoxItem Content="4.0x"/><ComboBoxItem Content="5.0x"/><ComboBoxItem Content="10.0x"/><ComboBoxItem Content="15.0x"/><ComboBoxItem Content="20.0x"/></ComboBox>
          <TextBlock Text="{DynamicResource RepeatInterval}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="IntervalBox" Width="66" Text="0" Style="{StaticResource ModernTextBox}"/><TextBlock Text="ms" VerticalAlignment="Center" Margin="-8,0,10,0" Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock Text="{DynamicResource RecordingCountdown}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="CountdownBox" Width="54" Text="0" Style="{StaticResource ModernTextBox}"/><TextBlock Text="{DynamicResource Second}" VerticalAlignment="Center" Margin="-8,0,10,0" Foreground="{DynamicResource MutedBrush}"/>
          </WrapPanel>
          <WrapPanel Margin="0,9,0,0" VerticalAlignment="Center">
          <CheckBox x:Name="StopPhysicalBox" Content="{DynamicResource StopOnPhysicalInput}"/>
          <CheckBox x:Name="SaveDialogStabilizationBox" Content="{DynamicResource SaveDialogAutoWait}"/>
          <TextBlock Text="{DynamicResource Maximum}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="SaveDialogTimeoutBox" Width="52" Text="15" Style="{StaticResource ModernTextBox}"/><TextBlock Text="{DynamicResource Second}" VerticalAlignment="Center" Margin="-8,0,10,0" Foreground="{DynamicResource MutedBrush}"/>
          <CheckBox x:Name="InstantMouseBox" Content="{DynamicResource InstantMouseMovement}" ToolTip="{DynamicResource InstantMouseToolTip}"/>
          <TextBlock Text="{DynamicResource Minimum}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="InstantMouseDelayBox" Width="52" Text="30" Style="{StaticResource ModernTextBox}"/><TextBlock Text="ms" VerticalAlignment="Center" Margin="-8,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
          </WrapPanel>
        </StackPanel>

        <WrapPanel x:Name="CoordinatePanel" Margin="0,13,0,0">
          <TextBlock Text="{DynamicResource CoordinateReference}" Margin="0,0,14,0" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <RadioButton x:Name="AbsoluteRadio" IsChecked="True" Content="{DynamicResource AbsoluteScreen}"/>
          <RadioButton x:Name="TargetRadio" Content="{DynamicResource TargetWindowRelative}"/>
          <TextBlock x:Name="TargetText" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Text="{DynamicResource NoTargetWindow}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="0,14" Background="{DynamicResource StatusBarBrush}" CornerRadius="14" Padding="16,13">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="10" Height="10" CornerRadius="5" Background="#5EE09A" VerticalAlignment="Center" Margin="0,0,11,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="StatusText" FontWeight="Bold" Foreground="White" Text="{DynamicResource StatusIdle}"/>
          <TextBlock x:Name="DetailText" Foreground="{DynamicResource StatusDetailBrush}" Margin="0,3,0,0" Text="{DynamicResource PrivacyNotice}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock x:Name="ElapsedText" Grid.Column="2" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="18,0" Text="00:00.0"/>
        <Border Grid.Column="3" Background="{DynamicResource StatusPanelBrush}" CornerRadius="10" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="EventCountText" Foreground="{DynamicResource StatusCountBrush}"/></Border>
      </Grid>
    </Border>

    <Grid x:Name="AdvancedWorkspace" Grid.Row="3">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="16" Effect="{StaticResource CardShadow}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{DynamicResource RecordedEvents}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource EventHelp}" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Click="OpenToolMenu_Click" Style="{StaticResource CompactButton}" Content="{DynamicResource DataTools}">
                <Button.ContextMenu>
                  <ContextMenu Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <MenuItem Header="{DynamicResource VariablesButton}" Click="Variables_Click"/>
                    <MenuItem Header="{DynamicResource InsertClipboardVariable}" Click="InsertClipboardVariable_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Click="OpenToolMenu_Click" Style="{StaticResource CompactButton}" Content="{DynamicResource WaitTools}">
                <Button.ContextMenu>
                  <ContextMenu Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <MenuItem Header="{DynamicResource InsertSaveWait}" Click="InsertSaveWait_Click"/>
                    <MenuItem Header="{DynamicResource InsertTextTrigger}" Click="InsertTextTrigger_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Click="OpenToolMenu_Click" Style="{StaticResource CompactButton}" Content="{DynamicResource ActionTools}">
                <Button.ContextMenu>
                  <ContextMenu Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <MenuItem Header="{DynamicResource RandomBranchButton}" Click="RandomBranch_Click"/>
                    <MenuItem Header="{DynamicResource EditSelected}" Click="EditEvent_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button x:Name="ToggleMovesButton" Click="ToggleMouseGroups_Click" Style="{StaticResource CompactButton}" Content="{DynamicResource ExpandMouseMoves}"/>
              <Button Click="DeleteEvent_Click" Style="{StaticResource CompactButton}" Margin="0" Content="{DynamicResource DeleteSelected}"/>
            </WrapPanel>
          </Grid>
          <ListBox x:Name="EventList" SelectionMode="Extended" KeyDown="EventList_KeyDown" MouseDoubleClick="EventList_MouseDoubleClick" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource ListBrush}" Foreground="{DynamicResource TextBrush}" Padding="6" FontFamily="Consolas">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveEventBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ActiveEventTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ActiveEventBorderBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Left" Width="25" Height="24" Padding="0" Margin="0,0,5,0"
                          Visibility="{Binding ExpandVisibility}" Content="{Binding ExpandGlyph}" Tag="{Binding}"
                          Click="ToggleMouseGroup_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                  <TextBlock Text="{Binding Display}" Margin="{Binding ContentMargin}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="AdvancedFooter" Grid.Row="4" Margin="2,12,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="HotkeyFooterText" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Grid.Column="1" Foreground="#98A2B3" Text="{DynamicResource LocalOnlyFooter}"/>
    </Grid>
  </Grid>
</Window>
