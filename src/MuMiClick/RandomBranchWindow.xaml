<Window x:Class="MuMiClick.RandomBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RandomBranchesTitle}" Icon="Assets/MuMiClick.ico"
        Width="900" Height="570" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#687386"/><SolidColorBrush x:Key="LineBrush" Color="#E3E8F0"/>
    <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="{DynamicResource RandomBranchesTitle}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource RandomBranchesHelp}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource AvailableActions}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,7"/>
        <ListBox x:Name="SourceList" Grid.Row="1" SelectionMode="Extended" DisplayMemberPath="Display" FontFamily="Consolas"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"/>
      </Grid>
      <Button Grid.Column="1" Content="{DynamicResource AddSelectedBranch}" Click="AddSelected_Click" Margin="14,0" VerticalAlignment="Center"/>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource BranchAlternatives}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,7"/>
        <DataGrid x:Name="BranchesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource FieldBrush}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource BranchName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            <DataGridTextColumn Header="{DynamicResource BranchEventCount}" Binding="{Binding Events.Count}" Width="90" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="{DynamicResource DeleteBranch}" Click="Delete_Click" Margin="0,9,0,0" HorizontalAlignment="Left"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{DynamicResource Cancel}" IsCancel="True"/><Button Content="{DynamicResource Apply}" Click="Apply_Click" IsDefault="True" Background="#2563EB" Foreground="White" BorderThickness="0"/></StackPanel>
  </Grid>
</Window>
