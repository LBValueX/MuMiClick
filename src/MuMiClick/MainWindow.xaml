<Window x:Class="MuMiClick.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MuMiClick - 마우스·키보드 매크로" Height="720" Width="1050" MinHeight="620" MinWidth="850" Closing="Window_Closing">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#F4F7FA" CornerRadius="6" Padding="12" Grid.Row="0">
      <StackPanel>
        <WrapPanel>
          <Button x:Name="RecordButton" Click="Record_Click" Background="#C62828" Foreground="White" FontWeight="Bold">● 녹화</Button>
          <Button x:Name="StopButton" Click="Stop_Click">■ 정지</Button>
          <Button x:Name="PlayButton" Click="Play_Click" Background="#1976D2" Foreground="White" FontWeight="Bold">▶ 재생</Button>
          <Button x:Name="PauseButton" Click="Pause_Click">Ⅱ 일시정지/재개</Button>
          <Button Click="Save_Click">저장</Button><Button Click="Load_Click">불러오기</Button><Button Click="SelectTarget_Click">대상 창 선택</Button><Button Click="Elevate_Click">관리자 재실행</Button>
        </WrapPanel>
        <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Text="반복 횟수:"/><TextBox x:Name="RepeatBox" Width="52" Text="1"/>
          <CheckBox x:Name="InfiniteBox" Margin="8,3" Content="무한 반복"/>
          <TextBlock VerticalAlignment="Center" Text="속도:"/><ComboBox x:Name="SpeedBox" Width="70" SelectedIndex="1"><ComboBoxItem Content="0.5x"/><ComboBoxItem Content="1.0x"/><ComboBoxItem Content="1.5x"/><ComboBoxItem Content="2.0x"/></ComboBox>
          <TextBlock VerticalAlignment="Center" Text="반복 간격(ms):"/><TextBox x:Name="IntervalBox" Width="60" Text="0"/>
          <TextBlock VerticalAlignment="Center" Text="녹화 전:"/><TextBox x:Name="CountdownBox" Width="45" Text="0"/><TextBlock VerticalAlignment="Center" Text="초"/>
          <CheckBox x:Name="StopPhysicalBox" Margin="12,3" Content="실제 입력 시 재생 중지"/>
        </WrapPanel>
        <WrapPanel Margin="0,5,0,0"><RadioButton x:Name="AbsoluteRadio" IsChecked="True" Content="화면 절대 좌표" Margin="0,0,16,0"/><RadioButton x:Name="TargetRadio" Content="대상 창 상대 좌표"/><TextBlock x:Name="TargetText" Margin="14,0,0,0" Foreground="#555" VerticalAlignment="Center" Text="대상 창: 선택 안 됨"/></WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Margin="0,10" Padding="10" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="StatusText" FontWeight="Bold" Text="상태: 대기"/><TextBlock x:Name="DetailText" Foreground="#666" Text="녹화는 사용자가 시작할 때만 입력을 수집합니다. 데이터는 외부로 전송되지 않습니다."/></StackPanel>
        <TextBlock x:Name="ElapsedText" Grid.Column="1" FontSize="22" VerticalAlignment="Center" Margin="10,0" Text="00:00.0"/>
        <TextBlock x:Name="EventCountText" Grid.Column="2" VerticalAlignment="Center" Text="이벤트 0개"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <GroupBox Header="녹화된 이벤트 (선택 후 Delete 키 또는 버튼으로 삭제)" Margin="0,0,10,0"><DockPanel><Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Click="DeleteEvent_Click">선택 삭제</Button><ListBox x:Name="EventList" DisplayMemberPath="Display" KeyDown="EventList_KeyDown"/></DockPanel></GroupBox>
      <GroupBox Grid.Column="1" Header="전역 단축키 설정"><StackPanel Margin="8"><TextBlock Text="녹화 시작/종료"/><TextBox x:Name="RecordHotkeyBox"/><TextBlock Text="재생 시작"/><TextBox x:Name="PlayHotkeyBox"/><TextBlock Text="일시정지/재개"/><TextBox x:Name="PauseHotkeyBox"/><TextBlock Text="긴급 중지"/><TextBox x:Name="StopHotkeyBox"/><Button Click="ApplyHotkeys_Click" Margin="3,12,3,3">단축키 적용</Button><TextBlock TextWrapping="Wrap" Foreground="#666" Margin="3,8">관리자 권한 프로그램은 동일하거나 더 높은 권한의 MuMiClick에서만 입력을 받을 수 있습니다. 필요하면 ‘관리자 재실행’을 사용하세요.</TextBlock></StackPanel></GroupBox>
    </Grid>
    <TextBlock Grid.Row="3" Margin="3,10,3,0" Foreground="#777" Text="기본 단축키: F8 녹화 · F9 재생 · F11 일시정지 · F7 긴급 중지 (F10 미사용)"/>
  </Grid>
</Window>
